#!/bin/sh
# Runtime environment for the SMM Monitor release.
#
# Generated into the release by `mix release`; edit rel/env.sh.eex, not
# the copy under _build. Sourced by bin/smm_monitor before the VM starts,
# so anything set here applies to every command (start, remote, eval).

# ---------------------------------------------------------------------
# Node distribution
# ---------------------------------------------------------------------
# SMM Monitor is a single node that never clusters. Leaving distribution
# on would make the release depend on epmd and on the host resolving its
# own hostname — a common way for a service to fail to start on a fresh
# box, for no benefit here.
#
# The cost is that `bin/smm_monitor remote` and `rpc` won't work. If you
# need those on a particular server, set RELEASE_DISTRIBUTION=name and
# RELEASE_NODE before starting.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# ---------------------------------------------------------------------
# Encoding
# ---------------------------------------------------------------------
# Mentions are full of non-ASCII text — em dashes, emoji, accented
# names — and so are the file paths they can end up in. A server with a
# minimal locale gives the VM latin1 name encoding, which Elixir warns
# about on every boot and which corrupts non-ASCII filenames. Force UTF-8
# rather than depending on the host's locale being set up.
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-+fnu}"
export LANG="${LANG:-C.UTF-8}"
