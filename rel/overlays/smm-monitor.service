# SMM Monitor — social media monitoring dashboard
#
# Install to /etc/systemd/system/smm-monitor.service
# See DEPLOY.md for the full deployment flow.

[Unit]
Description=SMM Monitor — social media monitoring dashboard
Documentation=https://github.com/phravins/SMM-Monitor
# The fetchers poll external APIs, so wait for real connectivity rather
# than network.target, which only means "the stack is configured".
After=network-online.target
Wants=network-online.target

[Service]
Type=exec

# A dedicated system user with no login shell and no home. It owns only
# its own state, so a compromise of the app is a compromise of the
# mention database and the API keys — not of the machine.
User=smm-monitor
Group=smm-monitor

# The release is deployed to a versioned directory with `current` as a
# symlink, so a rollback is a symlink swap and a restart.
WorkingDirectory=/opt/smm-monitor/current
ExecStart=/opt/smm-monitor/current/bin/smm_monitor start

# Secrets live here, not in this file — a unit file is world-readable and
# ends up in git. The leading `-` means the service still starts if the
# file is absent, which is what you want on a first install before any
# credentials exist: it comes up in mock mode.
EnvironmentFile=-/etc/smm-monitor/env

# systemd creates, owns and passes these in; SmmMonitor.Paths reads them,
# so the unit and the app cannot disagree about where state lives.
#   /var/lib/smm-monitor — database, SSH host key
#   /etc/smm-monitor     — runtime config, authorized_keys, env file
StateDirectory=smm-monitor
StateDirectoryMode=0750
ConfigurationDirectory=smm-monitor
ConfigurationDirectoryMode=0750

Restart=on-failure
RestartSec=5s
# Give in-flight database writes a moment to finish before SIGKILL.
TimeoutStopSec=30s

# --- Hardening --------------------------------------------------------
# The app needs: outbound HTTPS, a listening port, and its own state
# directory. Everything else can be taken away.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The SSH dashboard binds 2222 by default. AF_UNIX is needed by the BEAM
# itself; AF_INET/AF_INET6 for the platform APIs and the SSH listener.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Below 1024 would need CAP_NET_BIND_SERVICE, which is why the default
# SSH port is 2222.
CapabilityBoundingSet=
AmbientCapabilities=

# --- Logging ----------------------------------------------------------
# The release logs to stdout; systemd routes that to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smm-monitor

[Install]
WantedBy=multi-user.target
