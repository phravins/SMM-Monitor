# SMM Monitor service environment
#
# Install to /etc/smm-monitor/env, owned root:smm-monitor mode 0640 —
# readable by the service, not writable by it, not readable by anyone
# else on the box.
#
#     sudo install -o root -g smm-monitor -m 0640 env.example /etc/smm-monitor/env
#
# systemd reads this as KEY=VALUE lines — it is not a shell script, so
# there is no expansion, no $VAR, no command substitution.
#
# Quote any value containing a space or a bracket. systemd strips the
# quotes, and it keeps the file safe to `set -a; . /etc/smm-monitor/env`
# if you ever want to test a setting by hand. Unquoted, a value like
#   REDDIT_USER_AGENT=smm_monitor/0.1 (by /u/you)
# is fine for systemd but a syntax error for a shell.
#
# Every setting here is optional. A platform with keys collects live
# data; one without shows NOT CONNECTED and collects nothing. Full list:
# docs/configuration.md

# --- What to track ---------------------------------------------------
# Defaults for a fresh install. Once someone edits them from the config
# screen, the saved values win and changing these has no effect.
SMM_KEYWORDS="realoffice,real office"
SMM_REDDIT_SUBREDDITS=smallbusiness,marketing,socialmedia,Entrepreneur

# --- Reddit (free) ---------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="smm_monitor/0.1 (by /u/yourusername)"

# --- YouTube (free, daily quota) -------------------------------------
# 18 minutes is what a full day of coverage costs; faster runs out of
# quota before the day ends. See docs/platforms.md#youtube.
YOUTUBE_API_KEY=
SMM_YOUTUBE_POLL_INTERVAL_MS=1080000

# --- X / Twitter (paid API plan) -------------------------------------
TWITTER_BEARER_TOKEN=
# SMM_TWITTER_MONTHLY_POST_BUDGET=10000
SMM_TWITTER_POLL_INTERVAL_MS=300000

# --- Instagram (Graph API, business account) -------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
SMM_INSTAGRAM_POLL_INTERVAL_MS=900000

# --- Bluesky (free, no account) -------------------------------------
# Off by default: it streams the whole network and uses bandwidth around
# the clock. See docs/platforms.md#bluesky.
# SMM_BLUESKY_ENABLED=true
# SMM_BLUESKY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# --- Discord (free, a bot in your servers) ---------------------------
# Create a bot with Message Content Intent and invite it to the servers
# to watch. See docs/platforms.md#discord.
DISCORD_BOT_TOKEN=
# SMM_DISCORD_GUILDS=123456789012345678
# SMM_DISCORD_CHANNELS=234567890123456789

# --- Threads (free, needs a Meta app) --------------------------------
# A long-lived token; it renews itself into threads_token.json next to the
# database. Search covers only your own posts until Meta's App Review.
# See docs/platforms.md#threads.
THREADS_ACCESS_TOKEN=
# SMM_THREADS_SOURCES=search,mentions
# SMM_THREADS_DAILY_QUERY_BUDGET=2000

# --- Remote dashboard over SSH ---------------------------------------
# Add team keys to /etc/smm-monitor/authorized_keys. Listens on
# 127.0.0.1 only: viewers connect through `ssh -L` or a VPN. Set
# SMM_SSH_BIND=0.0.0.0 only if the port is firewalled to people you
# trust. See docs/ssh.md.
SMM_SSH_ENABLED=true
SMM_SSH_PORT=2222
SMM_SSH_BIND=127.0.0.1

# --- Alerting --------------------------------------------------------
# Leave the webhook unset to log alerts only. Must be https.
SMM_ALERT_WEBHOOK_URL=

# --- Storage ---------------------------------------------------------
# Paths default to systemd's StateDirectory and ConfigurationDirectory
# (/var/lib/smm-monitor and /etc/smm-monitor), so they only need setting
# to override those.
SMM_RETENTION_DAYS=30

# --- Sentiment ---------------------------------------------------------
# Word lists that override the packaged ones, category by category. Put
# them outside the release: a deploy replaces the release directory.
# Copy the files you want to tune out of the release's priv/sentiment.
# SMM_SENTIMENT_DIR=/etc/smm-monitor/sentiment

# --- Demo data ---------------------------------------------------------
# Invented sample mentions instead of live collection. Not for a real
# deployment; the header says DEMO DATA while it is on.
# SMM_DEMO=1
