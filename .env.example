# Copy to .env and `set -a; source .env; set +a` before running with live data.
# Leave everything unset to run in mock mode (the default).

# Global default for every platform. Flip to false to enable live API
# calls everywhere. Platforms without credentials keep serving mock data
# instead of crashing.
SMM_MOCK_MODE=true

# Per-platform override of the line above. Reddit is the only platform
# with a live implementation, so this is the switch that matters:
# SMM_MOCK_REDDIT=false puts Reddit on live data while YouTube, Twitter
# and Instagram stay on fixtures. Leave it unset to inherit SMM_MOCK_MODE.
SMM_MOCK_REDDIT=true

# Comma-separated brand terms to monitor.
SMM_KEYWORDS=realoffice,real office

# Poll interval per platform, in milliseconds.
SMM_POLL_INTERVAL_MS=30000

# --- Reddit (LIVE) ---
# Create a "script" app at https://www.reddit.com/prefs/apps (free, no
# approval wait). The client id is the string under the app name; the
# secret is the field labelled "secret". See the README for a walkthrough.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit rejects generic or empty user agents. Include a contact if you can.
REDDIT_USER_AGENT=smm_monitor/0.1 (RealOffice)

# Comma-separated subreddits to watch. Leave unset to use the list in
# config/config.exs; set to an empty value to search all of Reddit.
SMM_REDDIT_SUBREDDITS=smallbusiness,marketing,socialmedia,Entrepreneur

# --- YouTube (free tier: Data API v3 key from Google Cloud Console) ---
YOUTUBE_API_KEY=

# --- Twitter/X (paid tier required — worker is stubbed, see README) ---
TWITTER_BEARER_TOKEN=

# --- Instagram (Graph API, business account required — worker is stubbed) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
