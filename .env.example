# SMM Monitor - local environment
#
# Copy to .env, fill in what you have, then load it before starting:
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#     mix smm.tui
#
# Nothing here is required. You can also type keys into the setup wizard
# on first run instead; a value set here always wins over the wizard.
#
# Each platform with keys collects LIVE data. A platform without keys
# shows NOT CONNECTED and collects nothing - it never invents mentions.
# Full details for every variable: docs/configuration.md

# --- What to track -----------------------------------------------------
# Comma-separated brand terms. Once clients are edited on the clients
# screen, the saved list wins.
SMM_KEYWORDS=realoffice,real office

# Default poll interval for platforms without their own, in ms. Only
# Reddit uses it: a client's subreddits are read this often.
SMM_POLL_INTERVAL_MS=15000

# --- Reddit (free) -----------------------------------------------------
# Create a "script" app at https://www.reddit.com/prefs/apps. The client
# id is the string under the app name; the secret is labelled "secret".
# Walkthrough: docs/platforms.md#reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit rejects generic user agents. Put your Reddit username in it.
REDDIT_USER_AGENT="smm_monitor/0.1 (by /u/yourusername)"
# Subreddits to watch, comma-separated. Empty searches all of Reddit.
SMM_REDDIT_SUBREDDITS=smallbusiness,marketing,socialmedia,Entrepreneur
# Read new comments in the subreddits too (one more request a poll).
# SMM_REDDIT_COMMENTS=true
# How often all of Reddit is searched for a client with no subreddits, ms.
# SMM_REDDIT_SEARCH_INTERVAL_MS=30000

# --- YouTube (free, daily quota) ---------------------------------------
# Enable "YouTube Data API v3" in a Google Cloud project and create an
# API key. Walkthrough: docs/platforms.md#youtube
YOUTUBE_API_KEY=
# A search costs 100 of the 10,000 free daily units. 18 minutes (80
# searches a day) keeps collection running around the clock; faster
# runs out of quota before the day ends and then pauses until midnight
# Pacific time.
SMM_YOUTUBE_POLL_INTERVAL_MS=1080000
SMM_YOUTUBE_DAILY_QUOTA_BUDGET=8000

# --- X / Twitter (paid API plan) ---------------------------------------
# Recent search needs a paid X API plan (Basic or above). Bearer token
# from the developer portal. Walkthrough: docs/platforms.md#x--twitter
TWITTER_BEARER_TOKEN=
# Your plan's monthly post cap; collection stops when it is reached.
# SMM_TWITTER_MONTHLY_POST_BUDGET=10000
# SMM_TWITTER_BILLING_CYCLE_DAY=1
SMM_TWITTER_POLL_INTERVAL_MS=300000

# --- Instagram (Graph API, business account) ---------------------------
# A long-lived access token and the Instagram business account id.
# Instagram has no keyword search: it sees posts that @-tag the account,
# comments on the account's own posts and, optionally, hashtags.
# Walkthrough: docs/platforms.md#instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# tags, comments, hashtag (comma-separated)
# SMM_INSTAGRAM_SOURCES=tags,comments
SMM_INSTAGRAM_POLL_INTERVAL_MS=900000

# --- Bluesky (free, no account) ---------------------------------------
# Streams every new post on Bluesky and keeps the ones naming a client's
# brand terms. Off by default because it uses bandwidth around the
# clock. Walkthrough: docs/platforms.md#bluesky
# SMM_BLUESKY_ENABLED=true
# Another Jetstream server, e.g. your own (must be wss://).
# SMM_BLUESKY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# Demo data for Bluesky only, without connecting.
# SMM_MOCK_BLUESKY=true

# --- Discord (free, a bot in your servers) -----------------------------
# Discord has no public search: create a bot, turn on Message Content
# Intent, and invite it to the servers to watch. It then streams every
# new message there and keeps the ones naming a client's brand terms.
# Walkthrough: docs/platforms.md#discord
DISCORD_BOT_TOKEN=
# Only these servers and/or channels (comma-separated ids from Discord's
# "Copy ID"). Unset reads every channel the bot can see.
# SMM_DISCORD_GUILDS=123456789012345678
# SMM_DISCORD_CHANNELS=234567890123456789,345678901234567890
# Demo data for Discord only, without connecting.
# SMM_MOCK_DISCORD=true

# --- Threads (free, needs a Meta app) ----------------------------------
# A long-lived Threads user token. It renews itself and the renewed one is
# kept in threads_token.json next to the database (0600).
# Until Meta approves the app in App Review, search only finds the
# connected account's own posts. Walkthrough: docs/platforms.md#threads
THREADS_ACCESS_TOKEN=
# Any of search, mentions, replies.
# SMM_THREADS_SOURCES=search,mentions
# Keyword searches per rolling 24 hours (Meta allows 2,200, shared by apps).
# SMM_THREADS_DAILY_QUERY_BUDGET=2000
# SMM_THREADS_POLL_INTERVAL_MS=300000
# Demo data for Threads only, without connecting.
# SMM_MOCK_THREADS=true

# --- Mastodon (free, needs an account on a server) ---------------------
# Listens live to one server. Make a token there under Preferences ->
# Development -> New application, with only the read:statuses scope.
# You see what that server knows about: a big server sees more.
# Walkthrough: docs/platforms.md#mastodon
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
# federated (every public post the server knows about) or local (only
# posts written there). The federated stream of a big server is busy.
# SMM_MASTODON_TIMELINE=federated
# Only if the server's own answer is wrong. Must be wss://.
# SMM_MASTODON_STREAMING_URL=wss://streaming.mastodon.social
# Demo data for Mastodon only, without connecting.
# SMM_MOCK_MASTODON=true

# --- News (free, no account) -------------------------------------------
# RSS and Atom feeds, read every 10 minutes and matched against every
# client's brand terms. https only, comma-separated, up to 100.
# Walkthrough: docs/platforms.md#news
# SMM_NEWS_FEEDS=https://opsledger.example/feed/,https://saasbriefing.example/atom.xml
# Or one feed per line in a file (# starts a comment).
# SMM_NEWS_FEEDS_FILE=/path/to/feeds.txt
# Also search Google News for each brand term. Off by default: Google
# publishes these feeds for personal, non-commercial use, so check its
# terms before using this for clients.
# SMM_NEWS_SEARCH=google
# SMM_NEWS_EDITION=en-US
# SMM_NEWS_POLL_INTERVAL_MS=600000
# Demo data for News only, without fetching.
# SMM_MOCK_NEWS=true

# --- Alerts ------------------------------------------------------------
# A Slack incoming webhook (must be https). Unset logs alerts only.
# SMM_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Remote dashboard over SSH -----------------------------------------
# Off by default. Listens on 127.0.0.1 only unless SMM_SSH_BIND is set.
# Needs Erlang/OTP 27.3.3+ (or 26.2.5.11+); see docs/ssh.md.
# SMM_SSH_ENABLED=true
# SMM_SSH_PORT=2222
# SMM_SSH_BIND=127.0.0.1

# --- Demo data ---------------------------------------------------------
# Invented sample mentions, for a demo or a screenshot. The header then
# says DEMO DATA. Leave this commented out for real monitoring.
# SMM_DEMO=1
