# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
smm_monitor-*.tar

# Temporary files, for example, from tests.
/tmp/

# Local environment overrides (API keys live here, never in git).
.env
.env.*
!.env.example

# Editor / OS noise
.elixir_ls/
.lexical/
.DS_Store

# Packaged releases from scripts/build_release.sh.
/dist/

# Self-contained binaries built by `mix release standalone`.
/burrito_out/

# Python bytecode from rendering PDF reports.
__pycache__/
*.pyc

# Runtime data. These hold mentions, API keys and SSH keys, and are
# created at run time - never commit one by accident.
*.db
*.db-wal
*.db-shm
/data/
/reports/
settings.json
authorized_keys
ssh_host_*
